# Public build-time setting, not a secret. Restart Vite after changing it.
# Local development defaults to ws://<current-page-hostname>:2567.
# For GitHub Pages, set the Actions Variable VITE_WS_URL to this deployed TLS endpoint.
# Leave VITE_WS_URL unset for local/LAN testing: the production server permits the Pages Origin only.
VITE_WS_URL=wss://battle.gvslike.xyz:8443/ws
